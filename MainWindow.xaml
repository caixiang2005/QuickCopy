<Window x:Class="QuickCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickCopy"
        Width="440" Height="520" MinWidth="300" MinHeight="520"
        WindowStyle="None" AllowsTransparency="False" Background="#121416"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#A9B0B8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                                <Setter Property="Foreground" Value="#7ED0A4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopRecordButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="CategoryComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryComboBox" TargetType="ComboBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource CategoryComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="7,0,0,0"
                                     BorderThickness="0" Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="#49A078" VerticalContentAlignment="Center"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ToggleButton Grid.Column="1" Focusable="False" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <TextBlock Text="▼" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" MaxHeight="180">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowShell" Background="{DynamicResource WindowBrush}"
            Focusable="True"
            BorderBrush="#3B4047" BorderThickness="1" CornerRadius="10"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ShellScale" ScaleX="0.985" ScaleY="0.985" />
                <TranslateTransform x:Name="ShellTranslate" Y="10" />
            </TransformGroup>
        </Border.RenderTransform>

        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="128" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="10,0,0,10"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="46" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="AddButton" Margin="8,8" Height="40"
                            Style="{StaticResource NavButton}" Foreground="#F3F5F7"
                            Background="{DynamicResource HoverBrush}" Click="AddButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="18" Margin="0,-1,6,0" />
                            <TextBlock Text="新增记录" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly" Margin="0,4,3,3">
                        <StackPanel Margin="10,4,7,8">
                            <Button x:Name="ClipboardButton" Content="剪贴板" Margin="0,0,0,7"
                                    Style="{StaticResource NavButton}" Click="Category_Click" />
                            <Grid Margin="10,0,0,7">
                                <TextBlock Text="标签" FontSize="11" Foreground="#777F88" VerticalAlignment="Center" />
                                <Button x:Name="DeleteCategoryButton" Content="×" Width="24" Height="24"
                                        HorizontalAlignment="Right" Margin="0,0,4,0" FontSize="15"
                                        Background="Transparent" Foreground="{DynamicResource MutedBrush}"
                                        BorderThickness="0" Cursor="Hand" ToolTip="删除当前标签"
                                        Click="DeleteCategory_Click" />
                            </Grid>
                            <StackPanel x:Name="CategoriesPanel">
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Button x:Name="ThemeButton" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="切换亮色主题" Click="ThemeButton_Click">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M12,3 V5 M12,19 V21 M3,12 H5 M19,12 H21 M5.64,5.64 L7.05,7.05 M16.95,16.95 L18.36,18.36 M18.36,5.64 L16.95,7.05 M7.05,16.95 L5.64,18.36 M12,8 A4,4 0 1 1 12,16 A4,4 0 1 1 12,8" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="22,7,18,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="SidebarToggleButton" Width="26" Height="22"
                                        Background="Transparent" Foreground="#949BA5" BorderThickness="0"
                                        Cursor="Hand" ToolTip="收起标签栏" Click="SidebarToggleButton_Click">
                                    <Viewbox Width="13" Height="13">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="SidebarToggleIcon"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Data="M14.5,4 L7.5,12 L14.5,20" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="WindowPinButton" Width="24" Height="22"
                                        Background="Transparent" Foreground="#949BA5" BorderThickness="0"
                                        Cursor="Hand" ToolTip="窗口置顶" Click="WindowPinButton_Click">
                                    <Viewbox Width="13" Height="13">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" Data="M8,3 H16 M9,3 L9,9 L6,13 H18 L15,9 L15,3 M12,13 V21" />
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Content="×" Width="30" Height="22"
                                        Background="Transparent" Foreground="#949BA5" BorderThickness="0"
                                        FontFamily="Microsoft YaHei UI" FontSize="16" Click="Close_Click" ToolTip="隐藏" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Height="34" VerticalAlignment="Bottom" Background="{DynamicResource InputBrush}"
                                BorderBrush="#3C4249" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="#828A94" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextBrush}" CaretBrush="#7ED0A4" FontFamily="Microsoft YaHei UI"
                                         FontSize="13" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                                <TextBlock Grid.Column="2" Text="Ctrl + Alt + Z" Foreground="#686F78" FontSize="11"
                                           Margin="14,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource PanelAltBrush}">
                    <ScrollViewer Margin="24,10,22,18"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel>
                            <Border x:Name="RecordTabsBar" Height="40" Margin="0,0,0,0"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="RecordTabsScroll" Grid.Column="0" HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"
                                              FontSize="12" Margin="0,0,10,0">
                                    <StackPanel x:Name="RecordsPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                                </ScrollViewer>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="EditRecordButton" Style="{StaticResource IconButton}"
                                            ToolTip="编辑当前便签" Click="EditRecord_Click">
                                        <Viewbox Width="12" Height="12">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" Data="M12,20 H21 M16.5,3.5 A2.12,2.12 0 0 1 19.5,6.5 L8,18 L4,19 L5,15 Z" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <Button x:Name="DeleteRecordButton" Style="{StaticResource IconButton}" Margin="0"
                                            ToolTip="删除当前便签" Click="DeleteRecord_Click">
                                        <Viewbox Width="12" Height="12">
                                            <Canvas Width="24" Height="24">
                                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" Data="M4,7 H20 M9,7 V4 H15 V7 M7,7 L8,21 H16 L17,7 M10,11 V17 M14,11 V17" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            </Border>
                            <StackPanel x:Name="FieldsPanel" />
                            <StackPanel x:Name="ClipboardPanel" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border x:Name="CopyToast" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,18" Padding="14,8" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="CopyToastText" Text="已复制" FontSize="12" FontWeight="SemiBold"
                           Foreground="#7ED0A4" />
            </Border>

            <Grid x:Name="EditorOverlay" Grid.ColumnSpan="2" Background="#99000000" Visibility="Collapsed">
                <Border Width="510" MaxHeight="500" Padding="26" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="EditorHeading" Text="新增记录" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18" />
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="名称" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,7" />
                                <TextBox x:Name="EditorTitle" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                                         Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" CaretBrush="#49A078" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="标签" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,7" />
                                <ComboBox x:Name="EditorCategory" Text="其他" IsEditable="True" IsTextSearchEnabled="False"
                                          Height="38" Padding="7,0" VerticalContentAlignment="Center"
                                          Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" FontSize="13"
                                          Style="{StaticResource CategoryComboBox}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="文本内容" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7" />
                        <Grid Grid.Row="3">
                            <TextBox x:Name="EditorRawText" MinHeight="220" MaxHeight="300" Padding="12,10"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" CaretBrush="#49A078" FontFamily="Microsoft YaHei UI" FontSize="13" />
                            <Border x:Name="EditorImagePreview" Width="118" Height="82" Margin="0,10,10,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource PanelAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                                <Image x:Name="EditorImage" Stretch="Uniform" Margin="4" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="取消" Width="78" Height="34" Margin="0,0,8,0" Click="CancelEditor_Click"
                                    Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                            <Button Content="保存" Width="78" Height="34" Click="SaveEditor_Click"
                                    Background="#49A078" Foreground="White" BorderBrush="#49A078" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
